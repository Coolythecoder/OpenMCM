{
  "schemaVersion": 1,
  "mcmApiVersion": 4,
  "rootPath": "_root.ConfigPanelFader.configPanel",
  "bootstrap": "MCMCompatBootstrap.install(journal)",
  "optionTypes": {
    "empty": 0,
