    "startPage",
    "endPage",
    "handleInput",
    "unlock",
    "setModNames",
    "setPageNames",
    "setCustomContentParams",
    "loadCustomContent",
    "unloadCustomContent",
    "setTitleText",
    "setInfoText",
    "setOptionFlagsBuffer",
    "setOptionTextBuffer",
    "setOptionStrValueBuffer",
